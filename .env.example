# Copie para .env.local (desenvolvimento) ou cadastre na hospedagem (produção).

# ── Sessão do painel (obrigatório) ─────────────────────────────
# Texto aleatório com 32+ caracteres. Gere com: npm run admin:hash -- "uma-senha"
SESSION_SECRET=

# ── Opção A: login local (sem Supabase Auth) ───────────────────
ADMIN_EMAIL=
# Gere com: npm run admin:hash -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=

# ── Opção B: Supabase (recomendado em produção) ────────────────
# Com estas duas variáveis, o conteúdo, as imagens e as mensagens vão para o Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Login pelo Supabase Auth (opcional; substitui a Opção A):
SUPABASE_ANON_KEY=
ADMIN_EMAILS=
# Nome do bucket de imagens (padrão: site-media)
SUPABASE_BUCKET=site-media

# ── Outros ─────────────────────────────────────────────────────
# Força o armazenamento: file | supabase (opcional)
CONTENT_DRIVER=
# Pasta dos dados no modo arquivo (padrão: ./data)
DATA_DIR=
# Endereço público do site (usado se o campo SEO > Endereço final estiver vazio)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
